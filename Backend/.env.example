# ==============================================================================
# RicozViz Analytics Platform — Backend Environment Configuration
# ==============================================================================

# Database Connection (Supabase / Render / Cloud PostgreSQL)
# Format: postgresql+asyncpg://user:password@host:port/database
# Note: config.py will automatically prefix postgres:// or postgresql:// with postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://postgres:your_password@db.supabase.co:5432/postgres

# Synchronous connection (optional, auto-derived if omitted)
DATABASE_SYNC_URL=postgresql+psycopg://postgres:your_password@db.supabase.co:5432/postgres

# JWT Secret Key (Use high-entropy 256-bit string in production)
SECRET_KEY=replace-with-a-secure-random-256-bit-production-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS origins (comma-separated list of your Vercel domains)
CORS_ORIGINS=https://your-ricozviz-app.vercel.app,http://localhost:3000

# File storage directory for tenant datasets
UPLOAD_DIR=/app/uploads
